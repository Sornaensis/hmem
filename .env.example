# Docker Compose interpolation values for compose.yaml.
# Copy to .env and replace placeholders before running docker compose.

POSTGRES_DB=hmem
POSTGRES_USER=hmem
# Required: leave empty to make postgres fail closed until a real password is set.
POSTGRES_PASSWORD=

# hmem uses libpq sslmode for the app connection to PostgreSQL.
HMEM_DB_SSLMODE=disable

# The Compose stack builds this tag from Dockerfile when needed.
HMEM_IMAGE=hmem:local

# Bind the web/API port to loopback by default. Set HMEM_HTTP_BIND=0.0.0.0 only
# after configuring safe deployed auth or a strong local static bearer token.
HMEM_HTTP_BIND=127.0.0.1
HMEM_HTTP_PORT=8420

# Default official postgres keeps hmem usable with similarity search disabled.
# Enable pgvector-backed similarity by uncommenting the pgvector image.
# POSTGRES_IMAGE=pgvector/pgvector:pg17

# Runtime env file consumed by the app, migrate, and mcp services.
# By default, put authentication/frontend settings below in config/compose.env
# (copy config/compose.env.example). Compose does not pass root .env auth values
# to containers automatically. To keep runtime settings in this .env instead,
# explicitly change the next line to HMEM_ENV_FILE=.env and configure them here.
HMEM_ENV_FILE=./config/compose.env

# Safe local bearer profile. Supply a human browser or bot API token/file;
# startup fails until one is supplied. Keep local bootstrap disabled in Compose.
HMEM_AUTH_MODE=local
HMEM_AUTH_ENABLED=true
HMEM_AUTH_LOCAL_BOOTSTRAP_ENABLED=false
HMEM_AUTH_LOCAL_ALLOW_REMOTE_BOOTSTRAP=false
# HMEM_AUTH_LOCAL_USER_TOKEN=replace-with-strong-human-browser-token
# HMEM_AUTH_LOCAL_USER_TOKEN_FILE=/run/secrets/hmem_local_user_token
# Optional distinct automated API/MCP credential; requires bot identity on writes.
# HMEM_API_KEY=replace-with-distinct-strong-bot-bearer-token
# HMEM_API_KEY_FILE=/run/secrets/hmem_api_key

# Deployed OIDC: set HMEM_AUTH_MODE=deployed, issuer and audience, and at least
# one of discovery URL, JWKS URL or JWKS file. URLs must use HTTPS.
# Browser login defaults on in deployed web mode and also requires client ID,
# client secret and redirect URI, plus discovery or BOTH explicit endpoints.
# Bootstrap the first administrator with:
#   docker compose run --rm hmem hmem-ctl auth bootstrap-superadmin --help
# HMEM_AUTH_MODE=deployed
# HMEM_AUTH_DEPLOYED_ISSUER=https://issuer.example
# HMEM_AUTH_DEPLOYED_AUDIENCE=hmem-web
# HMEM_AUTH_DEPLOYED_DISCOVERY_URL=https://issuer.example/.well-known/openid-configuration
# HMEM_AUTH_DEPLOYED_JWKS_URL=https://issuer.example/.well-known/jwks.json
# HMEM_AUTH_DEPLOYED_JWKS_FILE=/run/secrets/hmem_jwks.json
# HMEM_AUTH_DEPLOYED_CLIENT_ID=hmem-web
# HMEM_AUTH_DEPLOYED_CLIENT_SECRET=replace-with-oidc-client-secret
# HMEM_AUTH_DEPLOYED_CLIENT_SECRET_FILE=/run/secrets/hmem_oidc_client_secret
# HMEM_AUTH_DEPLOYED_REDIRECT_URI=https://hmem.example.com/api/v1/auth/callback
# HMEM_AUTH_DEPLOYED_AUTHORIZATION_ENDPOINT=https://issuer.example/protocol/openid-connect/auth
# HMEM_AUTH_DEPLOYED_TOKEN_ENDPOINT=https://issuer.example/protocol/openid-connect/token
HMEM_AUTH_DEPLOYED_SCOPES=openid,profile,email
HMEM_AUTH_DEPLOYED_TOKEN_LOOKUP=database
# Set a stable secret before issuing PATs/service tokens; keep it across restarts.
# HMEM_AUTH_DEPLOYED_TOKEN_HASH_SECRET=replace-with-stable-token-hash-secret
# HMEM_AUTH_DEPLOYED_TOKEN_HASH_SECRET_FILE=/run/secrets/hmem_token_hash_secret
HMEM_AUTH_DEPLOYED_SESSION_COOKIE_NAME=hmem_session
HMEM_AUTH_DEPLOYED_CSRF_COOKIE_NAME=hmem_csrf
HMEM_AUTH_DEPLOYED_CSRF_HEADER_NAME=X-CSRF-Token
HMEM_AUTH_DEPLOYED_SESSION_TTL_SECONDS=28800
HMEM_AUTH_DEPLOYED_COOKIE_SECURE=true
HMEM_AUTH_DEPLOYED_COOKIE_SAME_SITE=Lax
# SameSite=None requires COOKIE_SECURE=true. Leave CORS empty for same-origin
# use; deployed cookie auth must not use wildcard origins.
HMEM_CORS_ALLOWED_ORIGINS=

# *_FILE paths are inside the container. Mount each file read-only through a
# Compose override (secrets or bind mounts), readable by UID 10001. The base
# compose.yaml supplies no secret mounts. For shared *_FILE variables (including
# MCP tokens), mount each referenced file in every consuming hmem/migrate/mcp
# service, or scope the variable to only the service with the mount.
# *_FILE takes precedence over its value.

# Optional MCP profile tokens; HMEM_MCP_AUTH_TOKEN takes priority over fallback
# HMEM_AUTH_TOKEN. Compose supplies the upstream URL below as HMEM_SERVER_URL.
# Use an HTTPS URL with a certificate-matching hostname when hmem serves TLS.
HMEM_MCP_SERVER_URL=http://hmem:8420
# HMEM_MCP_AUTH_TOKEN=replace-with-mcp-service-token
# HMEM_MCP_AUTH_TOKEN_FILE=/run/secrets/hmem_mcp_auth_token
# HMEM_AUTH_TOKEN=replace-with-fallback-service-token
# HMEM_AUTH_TOKEN_FILE=/run/secrets/hmem_auth_token

# Frontend runtime config is public: non-secret values only, never bearer tokens.
# Auth mode defaults to HMEM_AUTH_MODE; deployed mode defaults login/logout URLs
# below and server-side OIDC login to true (local mode defaults it to false).
# HMEM_FRONTEND_API_URL=https://hmem.example.com
# HMEM_FRONTEND_WS_URL=wss://hmem.example.com/api/v1/ws
# HMEM_FRONTEND_AUTH_MODE=deployed
# HMEM_FRONTEND_LOGIN_URL=/api/v1/auth/login
# HMEM_FRONTEND_LOGOUT_URL=/api/v1/auth/logout
HMEM_FRONTEND_LOGOUT_REDIRECT_URL=/
# HMEM_FRONTEND_SERVER_SIDE_OIDC_LOGIN=true
# CSRF names inherit the server's deployed CSRF names unless overridden.
# HMEM_FRONTEND_CSRF_COOKIE_NAME=hmem_csrf
# HMEM_FRONTEND_CSRF_HEADER_NAME=X-CSRF-Token
HMEM_FRONTEND_AUTH_TOKEN_STORAGE=local
HMEM_FRONTEND_AUTH_TOKEN_STORAGE_KEY=hmem-auth-token
HMEM_FRONTEND_AUTH_TOKEN_URL_PARAMS=hmem_token,auth_token,access_token
HMEM_FRONTEND_REQUIRE_AUTH_STATE=true
