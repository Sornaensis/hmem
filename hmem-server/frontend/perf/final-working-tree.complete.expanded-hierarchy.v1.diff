+    const seedSuccess = () => {
+      fs.writeFileSync(manifestPath, JSON.stringify({ qualificationPassed: true }))
+      fs.writeFileSync(validationPath, JSON.stringify({ passed: true }))
+      fs.writeFileSync(diffPath, 'previous complete diff')
