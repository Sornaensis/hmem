+export const EVIDENCE_OUTPUT_LIMITS = Object.freeze({
+  commandBytes: 32 * 1024 * 1024, totalBytes: 128 * 1024 * 1024,
+  commandTimeoutMs: 30000, totalTimeoutMs: 60000
