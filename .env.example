# Docker Compose interpolation values for compose.yaml.
# Copy to .env and replace placeholders before running docker compose.

POSTGRES_DB=hmem
POSTGRES_USER=hmem
# Required: leave empty to make postgres fail closed until a real password is set.
POSTGRES_PASSWORD=

# The Compose stack builds this tag from Dockerfile when needed.
HMEM_IMAGE=hmem:local

# Bind the web/API port to loopback by default. Set HMEM_HTTP_BIND=0.0.0.0 only
# after configuring safe deployed auth or a strong local static bearer token.
HMEM_HTTP_BIND=127.0.0.1
HMEM_HTTP_PORT=8420

# Default official postgres keeps hmem usable with similarity search disabled.
# Enable pgvector-backed similarity by uncommenting the pgvector image.
# POSTGRES_IMAGE=pgvector/pgvector:pg17

# Optional hmem env file consumed by the app, migrate, and mcp services.
HMEM_ENV_FILE=./config/compose.env
