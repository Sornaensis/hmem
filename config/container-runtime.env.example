# hmem container runtime env contract example
# Copy to a Compose env file or secret manager. Replace all placeholder secrets.

# Filesystem contract: the image must set HOME and passwd home to /var/lib/hmem.
HOME=/var/lib/hmem

# Server and web
HMEM_SERVER_HOST=0.0.0.0
HMEM_SERVER_PORT=8420
HMEM_WEB_ENABLED=true
HMEM_WEB_STATIC_DIR=/opt/hmem/static

# Database
HMEM_DB_HOST=postgres
HMEM_DB_PORT=5432
HMEM_DB_NAME=hmem
HMEM_DB_USER=hmem
# Secret: prefer HMEM_DB_PASSWORD_FILE in Compose/Kubernetes secrets.
# HMEM_DB_PASSWORD=replace-with-database-password
# HMEM_DB_PASSWORD_FILE=/run/secrets/hmem_db_password
HMEM_DB_SSLMODE=disable

# Pool
HMEM_POOL_SIZE=10
HMEM_POOL_IDLE_TIMEOUT=60
HMEM_POOL_STATEMENT_TIMEOUT_MS=30000

# Logging
HMEM_LOG_LEVEL=info
HMEM_LOG_MAX_SIZE_MB=10
HMEM_LOG_BACKUP_COUNT=5

# CORS: leave empty for same-origin frontend/API. Use comma-separated trusted origins only.
HMEM_CORS_ALLOWED_ORIGINS=

# Default safe local static-bearer profile.
# The entrypoint must fail fast until HMEM_API_KEY or HMEM_API_KEY_FILE is supplied.
HMEM_AUTH_MODE=local
HMEM_AUTH_ENABLED=true
HMEM_AUTH_LOCAL_BOOTSTRAP_ENABLED=false
HMEM_AUTH_LOCAL_ALLOW_REMOTE_BOOTSTRAP=false
# Secret: prefer HMEM_API_KEY_FILE.
# HMEM_API_KEY=replace-with-static-bearer-token
# HMEM_API_KEY_FILE=/run/secrets/hmem_api_key

# Deployed OIDC/session profile (set HMEM_AUTH_MODE=deployed and configure these).
# HMEM_AUTH_DEPLOYED_ISSUER=https://issuer.example
# HMEM_AUTH_DEPLOYED_AUDIENCE=hmem-web
# HMEM_AUTH_DEPLOYED_DISCOVERY_URL=https://issuer.example/.well-known/openid-configuration
# HMEM_AUTH_DEPLOYED_JWKS_URL=https://issuer.example/.well-known/jwks.json
# HMEM_AUTH_DEPLOYED_JWKS_FILE=/run/secrets/hmem_jwks.json
HMEM_AUTH_DEPLOYED_TOKEN_LOOKUP=database
# Secret: prefer *_FILE.
# HMEM_AUTH_DEPLOYED_TOKEN_HASH_SECRET_FILE=/run/secrets/hmem_token_hash_secret
# HMEM_AUTH_DEPLOYED_CLIENT_ID=hmem-web
# HMEM_AUTH_DEPLOYED_CLIENT_SECRET_FILE=/run/secrets/hmem_oidc_client_secret
# HMEM_AUTH_DEPLOYED_REDIRECT_URI=https://hmem.example.com/api/v1/auth/callback
HMEM_AUTH_DEPLOYED_SCOPES=openid,profile,email
# HMEM_AUTH_DEPLOYED_AUTHORIZATION_ENDPOINT=https://issuer.example/protocol/openid-connect/auth
# HMEM_AUTH_DEPLOYED_TOKEN_ENDPOINT=https://issuer.example/protocol/openid-connect/token
HMEM_AUTH_DEPLOYED_SESSION_COOKIE_NAME=hmem_session
HMEM_AUTH_DEPLOYED_CSRF_COOKIE_NAME=hmem_csrf
HMEM_AUTH_DEPLOYED_CSRF_HEADER_NAME=X-CSRF-Token
HMEM_AUTH_DEPLOYED_SESSION_TTL_SECONDS=28800
HMEM_AUTH_DEPLOYED_COOKIE_SECURE=true
HMEM_AUTH_DEPLOYED_COOKIE_SAME_SITE=Lax

# Rate limiting
HMEM_RATE_LIMIT_ENABLED=false
HMEM_RATE_LIMIT_REQUESTS_PER_SECOND=10.0
HMEM_RATE_LIMIT_BURST=20

# TLS: usually terminated by a reverse proxy; set both to enable hmem-server TLS.
# HMEM_TLS_CERT_FILE=/run/tls/tls.crt
# HMEM_TLS_KEY_FILE=/run/tls/tls.key

# Frontend runtime config: non-secret values only. Do not inject bearer tokens.
# HMEM_FRONTEND_API_URL=https://hmem.example.com
# HMEM_FRONTEND_WS_URL=wss://hmem.example.com/api/v1/ws
# Defaults to HMEM_AUTH_MODE when unset; set explicitly only when frontend and server auth modes differ.
# HMEM_FRONTEND_AUTH_MODE=local
# HMEM_FRONTEND_LOGIN_URL=/api/v1/auth/login
# HMEM_FRONTEND_LOGOUT_URL=/api/v1/auth/logout
HMEM_FRONTEND_LOGOUT_REDIRECT_URL=/
HMEM_FRONTEND_SERVER_SIDE_OIDC_LOGIN=true
HMEM_FRONTEND_CSRF_COOKIE_NAME=hmem_csrf
HMEM_FRONTEND_CSRF_HEADER_NAME=X-CSRF-Token
HMEM_FRONTEND_AUTH_TOKEN_STORAGE=local
HMEM_FRONTEND_AUTH_TOKEN_STORAGE_KEY=hmem-auth-token
HMEM_FRONTEND_AUTH_TOKEN_URL_PARAMS=hmem_token,auth_token,access_token
HMEM_FRONTEND_REQUIRE_AUTH_STATE=true

# MCP client/sidecar settings. Secrets must stay in env or secret files, never YAML/static assets.
HMEM_SERVER_URL=http://127.0.0.1:8420
# HMEM_MCP_AUTH_TOKEN=replace-with-mcp-service-token
# HMEM_MCP_AUTH_TOKEN_FILE=/run/secrets/hmem_mcp_auth_token
# HMEM_AUTH_TOKEN=replace-with-fallback-service-token
# HMEM_AUTH_TOKEN_FILE=/run/secrets/hmem_auth_token
