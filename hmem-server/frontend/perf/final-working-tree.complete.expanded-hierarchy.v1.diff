+    collapse(keys) { selectedRetry = null; collapsed = keys; index.setCollapsed(keys); check() },
+    replace(key, value) { selectedRetry = null; currentChildren = { ...currentChildren, [key]: value }; index.replaceChildren(key, value); check() }
